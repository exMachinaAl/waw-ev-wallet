+ db.prepare('INSERT INTO entries(transfer_id,account_id,delta) VALUES(?,?,?)').run(id,from,-amount);
+ db.prepare('INSERT INTO entries(transfer_id,account_id,delta) VALUES(?,?,?)').run(id,to,amount);
